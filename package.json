{
  "name": "smokyclaw-trainer",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "description": "Local-first training for Indian campus hiring tests \u2014 TCS NQT, Infosys SP, Wipro Elite, Capgemini. Python, DSA, SQL, Aptitude with in-browser code execution and exact mock-test formats.",
  "license": "MIT",
  "homepage": "https://github.com/therahul-yo/SmokyClaw-Trainer#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/therahul-yo/SmokyClaw-Trainer.git"
  },
  "bugs": {
    "url": "https://github.com/therahul-yo/SmokyClaw-Trainer/issues"
  },
  "keywords": [
    "tcs-nqt",
    "infosys",
    "wipro",
    "capgemini",
    "interview-prep",
    "spaced-repetition",
    "pyodide",
    "sql.js",
    "pwa"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "validate": "tsx scripts/validate-content.ts",
    "validate:fast": "tsx scripts/validate-content.ts --skip-exec",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm validate && pnpm test && pnpm build"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@uiw/react-codemirror": "^4.25.11",
    "clsx": "^2.1.1",
    "pyodide": "^0.29.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.14.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "highlight.js": "^11.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.34.3"
}
