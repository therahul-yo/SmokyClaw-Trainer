  {
    "id": "py-c-queue-simulation",
    "track": "python",
    "topic": "stack-queue",
    "type": "coding",
    "language": "python",
    "difficulty": "medium",
    "estMinutes": 12,
    "prompt": "Process operations on a queue. `push:x` appends x, `pop` removes front if present, and `peek` records the front or `None`.",
    "constraints": "0 <= len(ops) <= 10^5.",
    "examples": [
      {
        "input": "ops = ['push:5','peek','pop','peek']",
        "output": "[5, None]"
      }
    ],
    "starter": "def queue_outputs(ops):\n    # your code here\n    pass\n",
    "entry": "queue_outputs",
    "tests": [
      {
        "args": [
          [
            "push:5",
            "peek",
            "pop",
            "peek"
          ]
        ],
        "expect": [
          5,
          null
        ]
      },
      {
        "args": [
          [
            "peek",
            "push:1",
            "push:2",
            "pop",
            "peek"
          ]
        ],
        "expect": [
          null,
          2
        ]
      },
      {
        "args": [
          []
        ],
        "expect": []
      },
      {
        "args": [
          [
            "push:1",
            "push:2",
            "push:3",
            "pop",
            "pop",
            "peek"
          ]
        ],
        "expect": [
          3
        ]
      },
      {
        "args": [
          [
            "pop",
            "pop",
            "peek"
          ]
        ],
        "expect": [
          null
        ]
      },
      {
        "args": [
          [
            "push:9",
            "peek",
            "push:8",
            "peek"
          ]
        ],
        "expect": [
          9,
          9
        ]
      }
    ],
    "hints": [
      "Use collections.deque.",
      "popleft is O(1); list.pop(0) is O(n).",
      "Parse push values after ':'."
    ],
    "bruteForce": {
      "code": "def queue_outputs(ops):\n    q = []; out = []\n    for op in ops:\n        if op.startswith('push:'): q.append(int(op.split(':')[1]))\n        elif op == 'pop' and q: q.pop(0)\n        elif op == 'peek': out.append(q[0] if q else None)\n    return out",
      "complexity": "O(n^2) worst-case",
      "explanation": "pop(0) shifts the list."
    },
    "optimal": {
      "code": "from collections import deque\n\ndef queue_outputs(ops):\n    q = deque(); out = []\n    for op in ops:\n        if op.startswith('push:'): q.append(int(op.split(':')[1]))\n        elif op == 'pop' and q: q.popleft()\n        elif op == 'peek': out.append(q[0] if q else None)\n    return out",
      "complexity": "O(n) time, O(n) space",
      "explanation": "deque is the right Python queue."
    },
    "complexityCheck": {
      "question": "Why deque over list for queue pops?",
      "choices": [
        {
          "label": "popleft is O(1)",
          "correct": true
        },
        {
          "label": "It sorts automatically",
          "correct": false
        },
        {
          "label": "It prevents duplicates",
          "correct": false
        },
        {
          "label": "It is immutable",
          "correct": false
        }
      ]
    },
