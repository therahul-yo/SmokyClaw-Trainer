            2,
            3,
            4
          ]
        ],
        "expect": [
          1,
          2,
          3,
          4
        ]
      }
    ],
    "hints": [
      "A set tracks what has appeared.",
      "A list preserves output order.",
      "Only append when x not in seen."
    ],
    "bruteForce": {
      "code": "def dedupe_order(items):\n    out = []\n    for x in items:\n        if x not in out:\n            out.append(x)\n    return out",
      "complexity": "O(n^2) time",
      "explanation": "Membership in a list is linear."
    },
    "optimal": {
      "code": "def dedupe_order(items):\n    seen = set(); out = []\n    for x in items:\n        if x not in seen:\n            seen.add(x); out.append(x)\n    return out",
      "complexity": "O(n) time, O(n) space",
      "explanation": "Set membership is average O(1); output list keeps order."
    },
    "complexityCheck": {
      "question": "Why not just use set(items)?",
