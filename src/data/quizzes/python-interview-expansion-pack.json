          "label": "It does not guarantee the desired first-seen order as the output contract",
          "correct": true
        },
        {
          "label": "It cannot remove duplicates",
          "correct": false
        },
        {
          "label": "It is O(n^2)",
          "correct": false
        },
        {
          "label": "It only works for strings",
          "correct": false
        }
      ]
    },
